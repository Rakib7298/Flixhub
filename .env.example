# Placeholder template only. Copy to .env for local use; never commit real credentials.
# Empty optional values leave their integrations disabled and produce honest setup states.

# Public application URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL: use a pooled URL for DATABASE_URL and a direct URL for migrations
# POSTGRES_PASSWORD is consumed by docker-compose; replace every local placeholder.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://mediamatrix:change-me@localhost:5432/mediamatrix
DIRECT_URL=postgresql://mediamatrix:change-me@localhost:5432/mediamatrix

# Required for authentication; generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Set true only behind a reverse proxy that overwrites forwarded IP headers
TRUST_PROXY=false
# Optional one-time administrator seeding; leave unset for normal seeds
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=

# TMDB server-side credentials (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Optional streaming availability provider (Movie of the Night or supported compatible provider)
STREAMING_AVAILABILITY_API_KEY=
STREAMING_API_PROVIDER=
STREAMING_API_BASE_URL=
STREAMING_DEFAULT_COUNTRY=BD

# Optional playlist synchronization
GITHUB_TOKEN=
PLAYLIST_MAX_BYTES=5242880
PLAYLIST_FETCH_TIMEOUT_MS=15000
PLAYLIST_ALLOW_PRIVATE_NETWORK=false

# Optional background scheduling (Redis is not required by the base web application)
REDIS_URL=
SYNC_CRON_SECRET=
# Server-to-server URL used by workers (never use this value in browser code)
WEB_INTERNAL_URL=http://localhost:3000
# Comma-separated explicit sync targets for workers/sync-worker, e.g. movie:238,tv:1396
TMDB_SYNC_IDS=

# Optional separately deployed FFmpeg worker
TRANSCODER_WORKER_URL=
TRANSCODER_WORKER_API_KEY=
TRANSCODER_PORT=4100
TRANSCODER_STORAGE_ROOT=./data/transcoder
TRANSCODER_MAX_FILE_BYTES=2147483648
TRANSCODER_JOB_TIMEOUT_MS=900000

# Optional S3-compatible storage (including MinIO)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional SMTP for password recovery (recovery is unavailable without delivery configuration)
SMTP_URL=
EMAIL_FROM=MediaMatrix <no-reply@example.com>

# Optional self-hosted authorized media server adapters
JELLYFIN_SERVER_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_ALLOW_PRIVATE_NETWORK=false

# Optional self-hosted export manager (never enable on serverless)
MEDIAMATRIX_EXPORTS_ENABLED=false
MEDIAMATRIX_EXPORT_DIR=/var/lib/mediamatrix/exports
# MEDIAMATRIX_REPOSITORY_ROOT=/srv/mediamatrix
TRANSCODER_MAX_CONCURRENT=1
TRANSCODER_ALLOW_PRIVATE_NETWORK=false

# Automated test-only controls (not application integration flags)
# Use "prisma" only for real CLI migration acceptance; never use a dummy engine.
MEDIAMATRIX_TEST_MIGRATION=sql
# Live TMDB tests additionally require authorized server credentials; blank keeps them skipped.
MEDIAMATRIX_LIVE_TMDB=
